# Azure AI Foundry — OpenAI-compatible endpoint
# FOUNDRY_ENDPOINT should be the full OpenAI-compatible baseURL, e.g.
#   https://<resource>.services.ai.azure.com/openai/v1
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=5.6-terra

# Scott's half (Express + Inngest + Discord)
MEATBAG_SERVER=http://localhost:3000

# 1 = fake the humans in-process (no server needed)
# MEATBAG_MOCK=1

# Directory the agent operates on (defaults to cwd)
# AGENT_CWD=/path/to/victim/project
