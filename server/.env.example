# ── Runtime ────────────────────────────────────────────────────────────────
# Connect the Inngest client to the local Dev Server instead of Inngest Cloud.
INNGEST_DEV=1
# Express serve endpoint port (optional; defaults to 3000).
PORT=3000

# ── Discord ────────────────────────────────────────────────────────────────
# Bot needs Message Content + Server Members privileged intents enabled.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TASKS_CHANNEL_ID=
DISCORD_HR_CHANNEL_ID=
DISCORD_GENERAL_CHANNEL_ID=
DISCORD_APP_ID=
DISCORD_CLIENT_SECRET=

# ── HorizonDB (Azure Postgres, West US 2) ──────────────────────────────────
# Full connection string, e.g. postgres://user:pass@host:5432/db
HORIZON_URL=

# ── Azure AI Foundry ────────────────────────────────────────────────────────
# OpenAI-compatible baseURL, e.g. https://<resource>.services.ai.azure.com/openai/v1
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=
# Text-to-speech deployment for the nag voicemails.
FOUNDRY_DEPLOYMENT_TTS=gpt-4o-mini-tts
# Realtime speech deployment for the level 4 voice call.
FOUNDRY_DEPLOYMENT_REALTIME=gpt-realtime-2.1
FOUNDRY_DEPLOYMENT_REALTIME=

# ── ElevenLabs (nag voicemails) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Resend (escalation tiers 3–4) ───────────────────────────────────────────
RESEND_API_KEY=

# ── People ──────────────────────────────────────────────────────────────────
# Who gets the "enjoy your afternoon" email when the run completes.
USER_EMAIL=
# CC'd at escalation level 4 ("looping in leadership").
LEADERSHIP_EMAIL=

# ── Testing ─────────────────────────────────────────────────────────────────
# Pin every task to one person instead of round-robin. Discord user id or
# display name. Handy for testing against yourself; leave unset on camera.
ASSIGN_ALL_TO=
# How long each escalation level waits before the ladder climbs (default 2m).
# The full ladder is 4 waits, so 2m means ~8 minutes to close out unanswered.
WAIT_TIMEOUT=

# ── Demo insurance ──────────────────────────────────────────────────────────
# If set, a fake contractor auto-replies to each task after this many ms.
# Leave unset/empty on camera so real humans do the work.
CONTRACTOR_AUTOREPLY_MS=
